# Database
DATABASE_URL=postgresql://user:password@localhost:5432/freelearn_radar

# AI (WP7+)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Abort a single AI call before the serverless function itself is killed.
AI_REQUEST_TIMEOUT_MS=45000

# Search (WP5+)
TAVILY_API_KEY=

# Auth (WP2+)
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAILS=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-production

# Cron (WP10+)
CRON_SECRET=replace-with-cron-secret

# App
APP_URL=http://localhost:3000

# Seeding — sample courses are LOCAL ONLY and never seeded on production runtimes.
# Leave unset for production (project plan Rule 9: no fake course data in production).
SEED_SAMPLE_COURSES=false

# Discovery limits (WP6+)
DISCOVERY_QUERY_LIMIT=50
DISCOVERY_RESULT_LIMIT=10
AI_ANALYSIS_LIMIT=60
MAX_VERIFICATIONS_PER_RUN=25

# Source fetching (M18.4)
MAX_SOURCE_FETCHES_PER_RUN=60
SOURCE_FETCH_TIMEOUT_MS=10000
SOURCE_MAX_RESPONSE_BYTES=524288
SOURCE_MAX_REDIRECTS=5

# Monitor worker (M19.5)
# Set MONITOR_ENABLED=false to stop all outbound observation without redeploying.
MONITOR_ENABLED=true
MONITOR_DAILY_FETCH_BUDGET=50
MONITOR_CONCURRENCY=2
MONITOR_PER_DOMAIN_RPM=20
# Must carry a contact URL: providers use it to reach us instead of blocking us.
MONITOR_USER_AGENT=FreeLearnRadarBot/1.0 (+https://freelearnradar.com/about; course availability monitor)
# The market whose pricing this deployment sees. Observations from different
# regions are never compared, so an event only confirms within one region.
MONITOR_OBSERVED_REGION=US
MONITOR_WORKER_VERSION=m19.5

# Email / alerts (M19.10)
# Leave EMAIL_DRY_RUN=true until deliverability has been verified.
EMAIL_DRY_RUN=true
RESEND_API_KEY=
EMAIL_FROM=alerts@freelearnradar.com
EMAIL_REPLY_TO=
EMAIL_DAILY_BUDGET=500
EMAIL_REQUEST_TIMEOUT_MS=10000

# Feature flags (M19) — all default OFF; enable only after the STOP gates pass.
FEATURE_TOPIC_PAGES=false
FEATURE_TRACKER_UI=false
FEATURE_PRICE_ALERTS=false
# Writes observed price changes back onto the course row. Requires the STOP 3
# replay (npm run replay:events) to show zero false events first.
FEATURE_AUTO_STATUS=false

# M20 embedding / semantic search (flags OFF by default)
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=20
EMBEDDING_CONCURRENCY=2
EMBEDDING_DAILY_BUDGET_TOKENS=500000
EMBEDDING_QUERY_TIMEOUT_MS=400
EMBED_AI_DERIVED_FIELDS=false
VECTOR_QUERY_TIMEOUT_MS=250
VECTOR_TOP_K=50
QUERY_EMBEDDING_CACHE_TTL_DAYS=30
# Minimum cosine similarity for a semantic hit (plan §85, §89.5).
# Intentionally blank: the threshold must come from the labelled evaluation set,
# and while it is blank the semantic path stays off rather than returning
# whatever the top-K happens to be. Setting FEATURE_SEMANTIC_SEARCH or
# FEATURE_HYBRID_SEARCH to true without this value leaves search lexical-only.
RELEVANCE_FLOOR=
NL_INTENT_DAILY_CALLS=2000
NL_INTENT_PER_IP_HOURLY=20
NL_INTENT_MAX_QUERY_CHARS=512
FEATURE_SEMANTIC_SEARCH=false
FEATURE_HYBRID_SEARCH=false
FEATURE_NL_COURSE_FINDER=false
FEATURE_SIMILAR_COURSES=false
FEATURE_COURSE_COMPARE=false
FEATURE_LEARNING_PATHS=false
FEATURE_CROSS_LANGUAGE=false
FEATURE_MONETIZATION=false
FEATURE_COURSE_AFFILIATE=false
FEATURE_COMMERCE_AFFILIATE=false

# M21 coupon / discovery / media (flags OFF by default)
FEATURE_COUPON_DISCOVERY=false
FEATURE_COUPON_PUBLIC_SURFACE=false
FEATURE_MEDIA_RESOLVER=false
FEATURE_INTERESTS=false
FEATURE_DISCOVERY_UX=false
COUPON_DISCOVERY_MAX_PAGES_PER_RUN=5
COUPON_DISCOVERY_MAX_CANDIDATES=80
COUPON_VERIFY_CONCURRENCY=2
COUPON_VERIFY_LIMIT=25
IMAGE_RESOLVE_CONCURRENCY=4
# Bounded media resolution pass (runs on the coupon cron, own kill switch).
MEDIA_RESOLVE_LIMIT=40
MEDIA_RECHECK_HOURS=168
