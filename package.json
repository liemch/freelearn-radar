{
  "name": "freelearn-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "npm run db:migrate:run && npm run db:seed && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/db/migrate.ts",
    "db:migrate:http": "USE_NEON_HTTP=1 tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:http": "USE_NEON_HTTP=1 tsx src/db/seed.ts",
    "db:check": "bash scripts/db-check.sh",
    "db:studio": "drizzle-kit studio",
    "db:bootstrap:generate": "tsx scripts/generate-neon-bootstrap.ts",
    "monitor:once": "tsx scripts/monitor-once.ts",
    "replay:events": "tsx scripts/replay-events.ts",
    "search:baseline": "tsx scripts/search-baseline.ts",
    "search:benchmark": "tsx scripts/search-benchmark.ts",
    "search:intent-sample": "tsx scripts/search-intent-sample.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.4",
    "jose": "^6.0.12",
    "lucide-react": "^0.539.0",
    "next": "^15.4.6",
    "nextjs-toploader": "^3.9.17",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
